 module ad_data_clk #(
 
-  parameter   SINGLE_ENDED = 0
+  parameter   SINGLE_ENDED = 0,
+  parameter   RADAR_CLOCK_CLEANER = 0
 ) (
   input               rst,
+  input               clean_enable,
+  input               clean_run,
+  output              clean_locked,
   output              locked,
 
   input               clk_in_p,
@@ -70,8 +74,29 @@
   end
   endgenerate
 
-  BUFG i_clk_gbuf (
-    .I (clk_ibuf_s),
-    .O (clk));
+  generate if (RADAR_CLOCK_CLEANER == 1) begin: clean_clock
+    wire feedback, feedback_buf, conditioned, mmcm_locked;
+    wire select_clean = clean_enable & mmcm_locked;
+    // Disabled during the driver's low-rate initialization/timing scans.
+    // Enable only at 75..150 MHz: multiplier 8 keeps VCO at 600..1200 MHz.
+    MMCME2_BASE #(
+      .BANDWIDTH("LOW"), .CLKIN1_PERIOD(8.138),
+      .CLKFBOUT_MULT_F(8.0), .DIVCLK_DIVIDE(1),
+      .CLKOUT0_DIVIDE_F(8.0), .CLKOUT0_DUTY_CYCLE(0.5)
+    ) i_clean_mmcm (
+      .CLKIN1(clk_ibuf_s), .CLKFBIN(feedback_buf),
+      .CLKFBOUT(feedback), .CLKOUT0(conditioned),
+      .LOCKED(mmcm_locked), .PWRDWN(1'b0), .RST(~clean_run)
+    );
+    BUFG i_feedback (.I(feedback), .O(feedback_buf));
+    BUFGCTRL #(.INIT_OUT(0), .PRESELECT_I0("TRUE"), .PRESELECT_I1("FALSE")) i_clock_mux (
+      .I0(clk_ibuf_s), .I1(conditioned), .S0(~select_clean), .S1(select_clean),
+      .CE0(1'b1), .CE1(1'b1), .IGNORE0(1'b0), .IGNORE1(1'b0), .O(clk)
+    );
+    assign clean_locked=mmcm_locked;
+  end else begin: direct_clock
+    BUFG i_clk_gbuf (.I(clk_ibuf_s), .O(clk));
+    assign clean_locked=1'b0;
+  end endgenerate
 
 endmodule
